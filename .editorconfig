; Many editors are supported by default,
; for others please refer to: http://editorconfig.org/
; PHPStorm plugin: https://plugins.jetbrains.com/plugin/7294

; top-most EditorConfig file
root = true

; Unix-style newlines
[*]
end_of_line = LF
charset = utf-8
trim_trailing_whitespace = false

; PHP files
[*.{php,phtml}]
indent_style = tab

; Frontend files
[*.{css,js}]
indent_style = tab

[*.{json,yml}]
indent_style = space
indent_size = 2