{
	"name": "ovos/php-library",
	"description": "ovos library",
	"type": "library",
	"authors": [
		{
			"name": "Marcin Gil",
			"email": "mg@ovos.at"
		}
	],
  "require" : {
    "php": ">=8.0.0",
    "ext-redis": "*",
    "ext-json": "*",
    "ext-yaml": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-ctype": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-zend-opcache": "*",
    "ext-zlib": "*",
    "pear/console_table": "^1.3",
    "cocur/slugify": "^2.5",
    "cache/redis-adapter": "^1.1",
    "cache/filesystem-adapter": "^1.1",
    "cache/namespaced-cache": "^1.1",
    "phpmyadmin/motranslator": "^5.2",
		"cache/apcu-adapter": "^1.1",
		"cache/hierarchical-cache": "1.1.0 as 0.4",
		"cache/prefixed-cache": "^1.1",
		"doctrine/dbal": "^3.1"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Ovos\\": "src"
		}
	},
	"scripts": {
		"php:version":
		[
			"php -v"
		]
	}
}
