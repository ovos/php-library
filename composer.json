{
  "name": "ovos/php-library",
  "description": "ovos library",
  "type": "library",
  "authors": [
    {
      "name": "Marcin Gil",
      "email": "mg@ovos.at"
    }
  ],
  "require" : {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-ctype": "*",
    "ext-pdo": "*",
    "ext-dom": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-zend-opcache": "*",
    "ext-zlib": "*",
    "pear/console_table": "^1.3",
    "cocur/slugify": "^4"
  },
  "suggest": {
    "ext-yaml": "YAML is required if you plan to use the Application class.",
    "ext-apcu": "APCu is required if you plan to use the Application class.",
    "ext-redis": "YAML is required if you plan to use the Application class.",
    "ext-simplexml": "SimpleXML is required if you plan to load XML files."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Ovos\\": "src"
    }
  },
  "scripts": {
    "php:version":
    [
      "php -v"
    ]
  }
}
