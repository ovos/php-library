{
	"name": "ovos/php-library",
	"description": "ovos library",
	"type": "library",
	"authors": [
		{
			"name": "Marcin Gil",
			"email": "mg@ovos.at"
		}
	],
  "require" : {
    "php": ">=8.1",
    "ext-apcu": "*",
    "ext-redis": "*",
    "ext-json": "*",
    "ext-yaml": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-ctype": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-zend-opcache": "*",
    "ext-zlib": "*",
    "pear/console_table": "^1.3",
    "cocur/slugify": "^2.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Ovos\\": "src"
		}
	},
	"scripts": {
		"php:version":
		[
			"php -v"
		]
	}
}
