{
  "name": "ovos/php-library-ci",
  "description": "CI application for php-library self-testing",
  "type": "library",
  "authors": [
    {
      "name": "Marcin Gil",
      "email": "mg@ovos.at"
    }
  ],
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/ovos/php-library.git"
    },
    {
      "type": "git",
      "url": "https://github.com/ovos/php-module-system.git"
    }
  ],
  "require" : {
    "php": ">=8.3",
    "ext-apcu": "*",
    "ext-redis": "*",
    "ext-json": "*",
    "ext-yaml": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-ctype": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-zend-opcache": "*",
    "ovos/php-library": "dev-release/8.5",
    "ovos/php-module-system": "dev-release/8.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "code:update": "git pull --rebase",
    "cache:clear": "@php cli.php system cache clear",
    "migrations:run": "@php cli.php migrations run",
    "install-classmap": [
      "@composer install --no-dev --no-interaction --classmap-authoritative"
    ],
    "prod:install": [
      "@install-classmap"
    ],
    "php:version":
    [
      "php -v"
    ]
  }
}
